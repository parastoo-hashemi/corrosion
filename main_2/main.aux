\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Strongly supported results}{19}{subsection.8.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{1. The selected model learns current visible corrosion reasonably well under grouped specimen holdout.}{19}{section*.44}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. The dominant saved signal is image-driven, not multimodal.}{19}{section*.45}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. Medium-severity corrosion is easier than the extremes.}{20}{section*.46}\protected@file@percent }
