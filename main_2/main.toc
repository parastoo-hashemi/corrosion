\contentsline {subsection}{\numberline {8.2}Strongly supported results}{19}{subsection.8.2}%
\contentsline {paragraph}{1. The selected model learns current visible corrosion reasonably well under grouped specimen holdout.}{19}{section*.44}%
\contentsline {paragraph}{2. The dominant saved signal is image-driven, not multimodal.}{19}{section*.45}%
\contentsline {paragraph}{3. Medium-severity corrosion is easier than the extremes.}{20}{section*.46}%
\contentsline {subsection}{\numberline {8.3}Weak, negative, and inconclusive results}{20}{subsection.8.3}%
\contentsline {paragraph}{Weak result: late-stage severe corrosion is underestimated.}{20}{section*.47}%
\contentsline {paragraph}{Weak result: performance is group-dependent.}{20}{section*.48}%
\contentsline {paragraph}{Negative result: the multimodal model did not win on the held-out grouped test split.}{20}{section*.49}%
\contentsline {paragraph}{Negative result: offline predictions include physically impossible negatives.}{20}{section*.50}%
\contentsline {paragraph}{Inconclusive result: relationship to structural damage or residual capacity.}{20}{section*.51}%
