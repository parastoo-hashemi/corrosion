\@writefile{toc}{\contentsline {section}{\numberline {VIII}Conclusion}{4}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Spearman correlation between representative corrosion variables and final structural load capacity in pooled and mesh-stratified views. The pooled correlations are consistently positive, while the 4-mesh and 7-mesh correlations are weak or negative. This compact summary supports the paper's main interpretation that pooled corrosion-load trends are confounded by specimen-group structure.}}{5}{}\protected@file@percent }
\newlabel{fig:mesh-stratified-correlation}{{3}{5}{}{figure.3}{}}
